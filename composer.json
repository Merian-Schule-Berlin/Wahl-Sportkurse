{
    "name": "wahl-sportkurse/anmeldung",
    "description": "Anmeldesystem für die Wahl der Sportkurse",
    "type": "project",
    "require": {
        "php": "^8.5",
        "dompdf/dompdf": "^3.1",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
