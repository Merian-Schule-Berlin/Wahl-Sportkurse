{% extends 'layouts/admin.twig' %}
{% block title %}{{ halbjahr.name }}{% endblock %}
{% block content %}
<p class="mb-2"><a href="/administrator/halbjahre">← Alle Halbjahre</a></p>
<h1 class="h3 mb-3">{{ halbjahr.name }}</h1>

{% if flash %}<div class="alert alert-success">{{ flash }}</div>{% endif %}
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

<section class="card app-card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Halbjahr</h2>
        <form method="post" action="/administrator/halbjahre/{{ halbjahr.id }}">
            {{ csrf.field()|raw }}
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="name">Name</label>
                    <input class="form-control" type="text" name="name" id="name" required value="{{ halbjahr.name }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="sortierung">Sortierung</label>
                    <input class="form-control" type="number" name="sortierung" id="sortierung" value="{{ halbjahr.sortierung }}">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="aktiv" id="aktiv" value="1" {% if halbjahr.aktiv %}checked{% endif %}>
                        <label class="form-check-label" for="aktiv">Aktiv</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Speichern</button>
        </form>
    </div>
</section>

<section class="card app-card">
    <div class="card-body">
        <h2 class="h5 mb-2">Kurse in diesem Halbjahr</h2>
        <p class="text-muted small mb-3">
            Neue Kurse legen Sie unter <a href="/administrator/halbjahre">Halbjahre &amp; Sportkurse</a> an.
            Status anklicken, um den Kurs für <strong>{{ halbjahr.name }}</strong> wählbar bzw. nicht wählbar zu schalten.
        </p>
        {% if kurse is empty %}
            <p class="text-muted mb-0">Noch keine Kurse vorhanden. Bitte zuerst global anlegen.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-bordered align-middle admin-kurs-table mb-0">
                    <thead>
                        <tr>
                            <th>Kurs</th>
                            <th>Bewegungsfeld</th>
                            <th style="width:7rem">Teilnehmer</th>
                            <th style="width:10rem">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for k in kurse %}
                        <tr class="{% if not k.verfuegbar %}is-gray{% endif %}">
                            <td><span class="fw-medium">{{ k.name }}</span></td>
                            <td class="text-muted">{{ k.bewegungsfeld|default('—') }}</td>
                            <td class="text-muted">{{ k.teilnehmer|default(0) }}</td>
                            <td>
                                <form method="post" action="/administrator/halbjahre/{{ halbjahr.id }}/kurse/{{ k.id }}/verfuegbar" class="d-inline">
                                    {{ csrf.field()|raw }}
                                    <input type="hidden" name="verfuegbar" value="{{ k.verfuegbar ? '0' : '1' }}">
                                    <button type="submit"
                                            class="badge border-0 {% if k.verfuegbar %}text-bg-success{% else %}text-bg-secondary{% endif %}"
                                            title="{% if k.verfuegbar %}Auf nicht wählbar setzen{% else %}Auf wählbar setzen{% endif %}"
                                            style="cursor:pointer">
                                        {% if k.verfuegbar %}wählbar{% else %}nicht wählbar{% endif %}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
