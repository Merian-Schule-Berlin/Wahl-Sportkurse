{% extends 'layouts/admin.twig' %}
{% block title %}{{ halbjahr.name }}{% endblock %}
{% block content %}
<p class="mb-2"><a href="/administrator/halbjahre">← Alle Halbjahre</a></p>
<h1 class="h3 mb-3">{{ halbjahr.name }}</h1>

{% if flash %}<div class="alert alert-success">{{ flash }}</div>{% endif %}
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

<section class="card app-card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Halbjahr</h2>
        <form method="post" action="/administrator/halbjahre/{{ halbjahr.id }}">
            {{ csrf.field()|raw }}
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="name">Name</label>
                    <input class="form-control" type="text" name="name" id="name" required value="{{ halbjahr.name }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="sortierung">Sortierung</label>
                    <input class="form-control" type="number" name="sortierung" id="sortierung" value="{{ halbjahr.sortierung }}">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="aktiv" id="aktiv" value="1" {% if halbjahr.aktiv %}checked{% endif %}>
                        <label class="form-check-label" for="aktiv">Aktiv</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Speichern</button>
        </form>
    </div>
</section>

<section class="card app-card mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Neuen Kurs anlegen</h2>
        <form method="post" action="/administrator/halbjahre/{{ halbjahr.id }}/kurse" class="row g-3 align-items-end">
            {{ csrf.field()|raw }}
            <div class="col-md-6">
                <label class="form-label" for="kurs_name">Name</label>
                <input class="form-control" type="text" name="name" id="kurs_name" required>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="kurs_kap">Kapazität</label>
                <input class="form-control" type="number" name="kapazitaet" id="kurs_kap" min="1" value="20" required>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Anlegen</button>
            </div>
        </form>
    </div>
</section>

<section class="card app-card">
    <div class="card-body">
        <h2 class="h5 mb-2">Kurse bearbeiten</h2>
        <p class="text-muted small mb-3">
            Mit <strong>Grau</strong> sperren Sie einen Kurs für dieses Halbjahr – er erscheint in der Anmeldung ausgegraut und kann nicht angekreuzt werden.
            Mit <strong>Wählbar</strong> schalten Sie ihn wieder frei. Name, Kapazität und Sortierung speichern Sie über <strong>Speichern</strong>.
        </p>
        {% if kurse is empty %}
            <p class="text-muted mb-0">Noch keine Kurse in diesem Halbjahr.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-bordered align-middle admin-kurs-table mb-0">
                    <thead>
                        <tr>
                            <th>Kurs</th>
                            <th style="width:7rem">Kapazität</th>
                            <th style="width:6rem">Sort.</th>
                            <th style="width:6rem">Belegt</th>
                            <th style="width:8rem">Status</th>
                            <th style="width:14rem">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for k in kurse %}
                        <tr class="{% if not k.aktiv %}is-gray{% endif %}">
                            <td>
                                <input class="form-control" form="kurs-save-{{ k.id }}" type="text" name="name" value="{{ k.name }}" required>
                            </td>
                            <td>
                                <input class="form-control" form="kurs-save-{{ k.id }}" type="number" name="kapazitaet" min="1" value="{{ k.kapazitaet }}" required>
                            </td>
                            <td>
                                <input class="form-control" form="kurs-save-{{ k.id }}" type="number" name="sortierung" value="{{ k.sortierung }}">
                            </td>
                            <td>
                                <span class="{% if k.belegt >= k.kapazitaet %}text-danger fw-semibold{% else %}text-muted{% endif %}">
                                    {{ k.belegt }}/{{ k.kapazitaet }}
                                </span>
                            </td>
                            <td>
                                {% if k.aktiv %}
                                    <span class="badge text-bg-success">wählbar</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">grau</span>
                                {% endif %}
                            </td>
                            <td class="text-nowrap">
                                <form id="kurs-save-{{ k.id }}" method="post" action="/administrator/halbjahre/{{ halbjahr.id }}/kurse/{{ k.id }}" class="d-inline">
                                    {{ csrf.field()|raw }}
                                    <input type="hidden" name="aktiv" value="{{ k.aktiv ? '1' : '0' }}">
                                    <button type="submit" class="btn btn-sm btn-primary">Speichern</button>
                                </form>
                                <form method="post" action="/administrator/halbjahre/{{ halbjahr.id }}/kurse/{{ k.id }}" class="d-inline">
                                    {{ csrf.field()|raw }}
                                    <input type="hidden" name="name" value="{{ k.name }}">
                                    <input type="hidden" name="kapazitaet" value="{{ k.kapazitaet }}">
                                    <input type="hidden" name="sortierung" value="{{ k.sortierung }}">
                                    <input type="hidden" name="aktiv" value="{{ k.aktiv ? '0' : '1' }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        {% if k.aktiv %}Grau{% else %}Wählbar{% endif %}
                                    </button>
                                </form>
                                <form method="post" action="/administrator/halbjahre/{{ halbjahr.id }}/kurse/{{ k.id }}/delete" class="d-inline" onsubmit="return confirm('Kurs „{{ k.name }}“ wirklich löschen?');">
                                    {{ csrf.field()|raw }}
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
