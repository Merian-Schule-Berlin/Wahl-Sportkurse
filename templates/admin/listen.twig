{% extends 'layouts/admin.twig' %}
{% block title %}Kursteilnehmer{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Kursteilnehmer <span class="text-muted fs-6">({{ active_count }} Anmeldung{% if active_count != 1 %}en{% endif %})</span></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm" href="/administrator/listen/anmeldungen.csv">CSV exportieren</a>
        <a class="btn btn-outline-primary btn-sm" href="/administrator/listen/anmeldungen.pdf">PDF exportieren</a>
    </div>
</div>

{% if flash %}<div class="alert alert-success">{{ flash }}</div>{% endif %}
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-alle" data-bs-toggle="tab" data-bs-target="#pane-alle" type="button" role="tab">Alle Anmeldungen</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-kurse" data-bs-toggle="tab" data-bs-target="#pane-kurse" type="button" role="tab">Nach Kurs</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="pane-alle" role="tabpanel">
        {% if anmeldungen is empty %}
            <p class="text-muted">Noch keine aktiven Anmeldungen.</p>
        {% else %}
            <form method="post" action="/administrator/listen/anmeldungen/delete" id="listen-delete-form">
                {{ csrf.field()|raw }}
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="submit" class="btn btn-sm btn-outline-danger" id="listen-delete-selected" disabled
                            onclick="return confirm('Ausgewählte Anmeldungen wirklich löschen?');">
                        Auswahl löschen
                    </button>
                    <span class="text-muted small align-self-center" id="listen-selected-count">Keine Auswahl</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-bordered align-middle">
                        <thead>
                            <tr>
                                <th style="width:2.5rem">
                                    <input class="form-check-input" type="checkbox" id="listen-select-all" title="Alle auswählen" aria-label="Alle auswählen">
                                </th>
                                <th>Name</th>
                                <th>Tutorium</th>
                                <th>E-Mail</th>
                                <th>HJ1 (1. / Alt.)</th>
                                <th>HJ2 (1. / Alt.)</th>
                                <th>HJ3 (1. / Alt.)</th>
                                <th>HJ4 (1. / Alt.)</th>
                                <th>Datum</th>
                                <th style="width:6rem"></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for a in anmeldungen %}
                            <tr>
                                <td>
                                    <input class="form-check-input listen-row-check" type="checkbox" name="ids[]" value="{{ a.id }}" aria-label="{{ a.name }} auswählen">
                                </td>
                                <td>{{ a.name }}</td>
                                <td>{{ a.tutorium }}</td>
                                <td>{{ a.email }}</td>
                                <td>{{ a.hj1_kurs_name }}<br><small class="text-muted">Alt: {{ a.hj1_alt_name }}</small></td>
                                <td>{{ a.hj2_kurs_name }}<br><small class="text-muted">Alt: {{ a.hj2_alt_name }}</small></td>
                                <td>{{ a.hj3_kurs_name }}<br><small class="text-muted">Alt: {{ a.hj3_alt_name }}</small></td>
                                <td>{{ a.hj4_kurs_name }}<br><small class="text-muted">Alt: {{ a.hj4_alt_name }}</small></td>
                                <td>{{ a.created_at|date('d.m.Y H:i') }}</td>
                                <td class="text-nowrap">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            formaction="/administrator/listen/anmeldungen/{{ a.id }}/delete"
                                            formmethod="post"
                                            onclick="return confirm('Anmeldung von „{{ a.name }}“ wirklich löschen?');">
                                        Löschen
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </form>
        {% endif %}
    </div>

    <div class="tab-pane fade" id="pane-kurse" role="tabpanel">
        {% if nach_kurs is empty %}
            <p class="text-muted">Noch keine Kursteilnehmer.</p>
        {% else %}
            {% set currentHj = '' %}
            {% for block in nach_kurs %}
                {% if block.halbjahr_name != currentHj %}
                    {% set currentHj = block.halbjahr_name %}
                    <h2 class="h5 mt-3 mb-2">{{ block.halbjahr_name }}</h2>
                {% endif %}
                <div class="card app-card mb-3">
                    <div class="card-body py-3">
                        <h3 class="h6 mb-2">
                            {{ block.kurs_name }}
                            <span class="text-muted fw-normal">({{ block.teilnehmer|length }} Teilnehmer)</span>
                        </h3>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Tutorium</th>
                                        <th>E-Mail</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for t in block.teilnehmer %}
                                    <tr>
                                        <td>{{ t.name }}</td>
                                        <td>{{ t.tutorium }}</td>
                                        <td>{{ t.email }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    var form = document.getElementById('listen-delete-form');
    if (!form) return;
    var all = document.getElementById('listen-select-all');
    var btn = document.getElementById('listen-delete-selected');
    var label = document.getElementById('listen-selected-count');
    function checks() {
        return Array.prototype.slice.call(form.querySelectorAll('.listen-row-check'));
    }
    function sync() {
        var list = checks();
        var selected = list.filter(function (c) { return c.checked; }).length;
        if (btn) btn.disabled = selected === 0;
        if (label) {
            label.textContent = selected === 0
                ? 'Keine Auswahl'
                : (selected === 1 ? '1 ausgewählt' : selected + ' ausgewählt');
        }
        if (all) {
            all.checked = list.length > 0 && selected === list.length;
            all.indeterminate = selected > 0 && selected < list.length;
        }
    }
    if (all) {
        all.addEventListener('change', function () {
            checks().forEach(function (c) { c.checked = all.checked; });
            sync();
        });
    }
    form.addEventListener('change', function (e) {
        if (e.target && e.target.classList.contains('listen-row-check')) sync();
    });
    sync();
})();
</script>
{% endblock %}
