{# Compact help behind an info icon (Bootstrap tooltip). #}
{% set tip = text|default('') %}
{% if tip %}
<button type="button"
        class="settings-info"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        {% if html|default(false) %}data-bs-html="true"{% endif %}
        data-bs-title="{{ tip|e('html_attr') }}"
        aria-label="Hinweis">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
</button>
{% endif %}
