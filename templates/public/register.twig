{% extends 'layouts/base.twig' %}
{% block title %}Anmeldung Wahl-Sportkurse · {{ app_name }}{% endblock %}
{% block content %}
{% set wahlMap = old.wahl|default({}) %}
{% set altMap = old.alt|default({}) %}
<section class="card app-card">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">Anmeldung Wahl-Sportkurse</h1>
        <p class="text-muted mb-2">Bitte kreuzen Sie für jedes Halbjahr eine <strong>1.&nbsp;Wahl</strong> und eine <strong>Alternative</strong> an.</p>
        {% if kursbeschreibungen_html %}
            <p class="mb-3">{{ kursbeschreibungen_html|raw }}</p>
        {% elseif not kursbeschreibungen %}
            <p class="text-muted small mb-3">Kursbeschreibungen werden vom Administrator bereitgestellt, sobald eine Datei hinterlegt ist.</p>
        {% endif %}

        {% if admin_test_mode|default(false) %}
            <div class="alert alert-info">Testmodus: Die öffentliche Anmeldung ist geschlossen. Als Administrator können Sie den Ablauf trotzdem prüfen.</div>
        {% endif %}

        {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

        {% if not form_ready|default(false) %}
            <div class="alert alert-warning">
                Die Anmeldung ist noch nicht vollständig eingerichtet. Es müssen vier aktive Halbjahre mit jeweils mindestens zwei wählbaren Kursen vorhanden sein.
            </div>
            <p class="mb-0"><a class="btn btn-outline-primary" href="/">Zur Startseite</a></p>
        {% else %}
            <form method="post" action="/anmelden" id="register-form">
                {{ csrf.field()|raw }}

                <div id="wahl-regeln" class="wahl-regeln mb-3" aria-live="polite">
                    <p class="fw-semibold mb-2">Bedingungen der Kurswahl <span id="wahl-regeln-gesamt" class="wahl-regeln-gesamt"></span></p>
                    <ul class="wahl-regeln-list mb-0">
                        <li id="regel-hj" data-state="open">
                            <span class="wahl-regeln-icon" aria-hidden="true"></span>
                            <span class="wahl-regeln-text">Pro Halbjahr 1.&nbsp;Wahl und eine davon verschiedene Alternative</span>
                            <span class="wahl-regeln-detail" id="regel-hj-detail"></span>
                        </li>
                        <li id="regel-felder" data-state="open">
                            <span class="wahl-regeln-icon" aria-hidden="true"></span>
                            <span class="wahl-regeln-text">Mindestens zwei verschiedene Bewegungsfelder in der 1.&nbsp;Wahl</span>
                            <span class="wahl-regeln-detail" id="regel-felder-detail"></span>
                        </li>
                        <li id="regel-doppelt" data-state="open">
                            <span class="wahl-regeln-icon" aria-hidden="true"></span>
                            <span class="wahl-regeln-text">Kein Kursthema mehr als zweimal als 1.&nbsp;Wahl</span>
                            <span class="wahl-regeln-detail" id="regel-doppelt-detail"></span>
                        </li>
                    </ul>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle choice-matrix choice-matrix-wide mb-0">
                        <thead>
                            <tr>
                                <th scope="col" rowspan="2" class="align-middle">Sportkurs</th>
                                <th scope="col" rowspan="2" class="align-middle">Bewegungsfeld</th>
                                {% for hj in halbjahre %}
                                    <th scope="colgroup" colspan="2" class="text-center">{{ hj.name }}</th>
                                {% endfor %}
                            </tr>
                            <tr>
                                {% for hj in halbjahre %}
                                    <th scope="col" class="text-center choice-col">1.&nbsp;Wahl</th>
                                    <th scope="col" class="text-center choice-col">Alt.</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                        {% for k in kurse %}
                            <tr>
                                <td><span class="fw-medium">{{ k.name }}</span></td>
                                <td class="text-muted">{{ k.bewegungsfeld|default('') }}</td>
                                {% for hj in halbjahre %}
                                    {% set hjId = hj.id %}
                                    {% set available = attribute(k.verfuegbar, hjId)|default(attribute(k.verfuegbar, hjId ~ '')|default(false)) %}
                                    {% set oldWahl = attribute(wahlMap, hjId)|default(attribute(wahlMap, hjId ~ '')|default('')) %}
                                    {% set oldAlt = attribute(altMap, hjId)|default(attribute(altMap, hjId ~ '')|default('')) %}
                                    <td class="text-center{% if not available %} is-gray{% endif %}">
                                        {% if available %}
                                            <input class="form-check-input choice-radio"
                                                   type="radio"
                                                   name="wahl[{{ hjId }}]"
                                                   value="{{ k.id }}"
                                                   id="wahl-{{ hjId }}-{{ k.id }}"
                                                   data-hj="{{ hjId }}"
                                                   data-role="wahl"
                                                   {% if oldWahl != '' and oldWahl == k.id %}checked{% endif %}
                                                   required>
                                        {% else %}
                                            <span class="choice-blocked" aria-hidden="true">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center{% if not available %} is-gray{% endif %}">
                                        {% if available %}
                                            <input class="form-check-input choice-radio"
                                                   type="radio"
                                                   name="alt[{{ hjId }}]"
                                                   value="{{ k.id }}"
                                                   id="alt-{{ hjId }}-{{ k.id }}"
                                                   data-hj="{{ hjId }}"
                                                   data-role="alt"
                                                   {% if oldAlt != '' and oldAlt == k.id %}checked{% endif %}
                                                   required>
                                        {% else %}
                                            <span class="choice-blocked" aria-hidden="true">—</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ 2 + (halbjahre|length * 2) }}" class="text-muted">Noch keine Kurse angelegt.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label" for="vorname">Vorname</label>
                        <input class="form-control" type="text" name="vorname" id="vorname" required value="{{ old.vorname|default('') }}" autocomplete="given-name">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="nachname">Nachname</label>
                        <input class="form-control" type="text" name="nachname" id="nachname" required value="{{ old.nachname|default('') }}" autocomplete="family-name">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="tutorium">Tutorium</label>
                        <input class="form-control" type="text" name="tutorium" id="tutorium" required value="{{ old.tutorium|default('') }}" autocomplete="organization">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="email">E-Mail</label>
                        <input class="form-control" type="email" name="email" id="email" required value="{{ old.email|default('') }}" autocomplete="email">
                    </div>
                </div>

                {% include 'partials/bot_protection.twig' %}

                <button type="submit" class="btn btn-secondary" id="register-submit" disabled aria-disabled="true">Anmeldung absenden</button>
                <a class="btn btn-outline-primary ms-2" href="/">Abbrechen</a>
            </form>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block scripts %}
{% set bp = bot_protection|default({enabled: false, script_url: ''}) %}
{% if bp.enabled and bp.script_url %}
<script src="{{ bp.script_url }}" async defer></script>
{% endif %}
<script>
(function () {
    var form = document.getElementById('register-form');
    if (!form) return;
    var hjIds = [{% for hj in halbjahre %}{{ hj.id }}{% if not loop.last %},{% endif %}{% endfor %}];
    var hjNames = {
        {% for hj in halbjahre %}
        "{{ hj.id }}": {{ hj.name|json_encode|raw }}{% if not loop.last %},{% endif %}
        {% endfor %}
    };
    var kursMeta = {
        {% for k in kurse %}
        "{{ k.id }}": { name: {{ k.name|json_encode|raw }}, feld: {{ (k.bewegungsfeld|default(''))|json_encode|raw }} }{% if not loop.last %},{% endif %}
        {% endfor %}
    };
    var submitBtn = document.getElementById('register-submit');

    function setRegel(id, state, detail) {
        var li = document.getElementById(id);
        var det = document.getElementById(id + '-detail');
        if (!li) return;
        li.setAttribute('data-state', state);
        if (det) det.textContent = detail || '';
    }

    function evaluate() {
        var hjs = {};
        hjIds.forEach(function (id) {
            hjs[String(id)] = { wahl: null, alt: null };
        });
        form.querySelectorAll('input[data-role="wahl"]:checked').forEach(function (el) {
            hjs[el.getAttribute('data-hj')] = hjs[el.getAttribute('data-hj')] || {};
            hjs[el.getAttribute('data-hj')].wahl = el.value;
        });
        form.querySelectorAll('input[data-role="alt"]:checked').forEach(function (el) {
            hjs[el.getAttribute('data-hj')] = hjs[el.getAttribute('data-hj')] || {};
            hjs[el.getAttribute('data-hj')].alt = el.value;
        });

        var missing = [];
        var same = [];
        var primary = [];
        var felder = {};
        var feldLabels = {};
        var okHj = true;

        hjIds.forEach(function (rawId) {
            var id = String(rawId);
            var row = hjs[id] || {};
            var label = hjNames[id] || ('Halbjahr ' + id);
            if (!row.wahl || !row.alt) {
                missing.push(label);
                okHj = false;
                return;
            }
            if (row.wahl === row.alt) {
                same.push(label);
                okHj = false;
                return;
            }
            primary.push(row.wahl);
            var meta = kursMeta[row.wahl] || {};
            var feldRaw = (meta.feld || '').toString().trim();
            var feldKey = feldRaw !== '' ? feldRaw.toLowerCase() : ('kurs:' + row.wahl);
            felder[feldKey] = true;
            if (feldRaw !== '') feldLabels[feldKey] = feldRaw;
            else feldLabels[feldKey] = (meta.name || 'Kurs');
        });

        if (!okHj) {
            if (same.length) {
                setRegel('regel-hj', 'bad', 'Gleich in: ' + same.join(', '));
            } else if (missing.length) {
                setRegel('regel-hj', 'open', 'Noch offen: ' + missing.join(', '));
            } else {
                setRegel('regel-hj', 'open', '');
            }
        } else {
            setRegel('regel-hj', 'ok', 'Alle Halbjahre vollständig');
        }

        var feldCount = Object.keys(felder).length;
        if (primary.length === 0) {
            setRegel('regel-felder', 'open', 'Noch keine 1. Wahl');
        } else if (feldCount < 2) {
            setRegel('regel-felder', 'bad', 'Bisher ' + feldCount + ' Bewegungsfeld');
        } else {
            setRegel('regel-felder', 'ok', feldCount + ' Bewegungsfelder');
        }

        var counts = {};
        primary.forEach(function (kursId) {
            counts[kursId] = (counts[kursId] || 0) + 1;
        });
        var tooOften = [];
        Object.keys(counts).forEach(function (kursId) {
            if (counts[kursId] > 2) {
                var n = (kursMeta[kursId] && kursMeta[kursId].name) ? kursMeta[kursId].name : 'Kurs';
                tooOften.push(n + ' (' + counts[kursId] + '×)');
            }
        });
        if (tooOften.length) {
            setRegel('regel-doppelt', 'bad', tooOften.join(', '));
        } else if (primary.length === 0) {
            setRegel('regel-doppelt', 'open', 'Noch keine 1. Wahl');
        } else {
            setRegel('regel-doppelt', 'ok', 'In Ordnung');
        }

        var rulesOk = okHj && feldCount >= 2 && tooOften.length === 0 && primary.length === hjIds.length;
        var formOk = personalDataOk();
        var allOk = rulesOk && formOk;
        var gesamt = document.getElementById('wahl-regeln-gesamt');
        var box = document.getElementById('wahl-regeln');
        if (gesamt) {
            gesamt.textContent = rulesOk ? '– erfüllt' : '– noch nicht erfüllt';
        }
        if (box) {
            box.setAttribute('data-complete', rulesOk ? '1' : '0');
        }
        if (submitBtn) {
            submitBtn.disabled = !allOk;
            submitBtn.setAttribute('aria-disabled', allOk ? 'false' : 'true');
            submitBtn.classList.toggle('btn-primary', allOk);
            submitBtn.classList.toggle('btn-secondary', !allOk);
            submitBtn.title = allOk
                ? ''
                : (!rulesOk
                    ? 'Bitte zuerst alle Wahlbedingungen erfüllen und das Formular ausfüllen.'
                    : 'Bitte Vorname, Nachname, Tutorium und gültige E-Mail ausfüllen.');
        }
        return allOk;
    }

    function personalDataOk() {
        var vorname = (document.getElementById('vorname') || {}).value || '';
        var nachname = (document.getElementById('nachname') || {}).value || '';
        var tutorium = (document.getElementById('tutorium') || {}).value || '';
        var emailEl = document.getElementById('email');
        var email = (emailEl || {}).value || '';
        if (vorname.trim() === '' || nachname.trim() === '' || tutorium.trim() === '' || email.trim() === '') {
            return false;
        }
        if (emailEl && typeof emailEl.checkValidity === 'function' && !emailEl.checkValidity()) {
            return false;
        }
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim());
    }

    form.addEventListener('change', evaluate);
    form.addEventListener('input', evaluate);
    form.addEventListener('submit', function (e) {
        if (!evaluate()) {
            e.preventDefault();
            var box = document.getElementById('wahl-regeln');
            if (box && box.getAttribute('data-complete') !== '1') {
                box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                var vorname = document.getElementById('vorname');
                if (vorname) vorname.focus();
            }
        }
    });
    evaluate();
})();
</script>
{% endblock %}
