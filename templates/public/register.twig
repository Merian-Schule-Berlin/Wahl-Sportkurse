{% extends 'layouts/base.twig' %}
{% block title %}Sportkurse wählen · {{ app_name }}{% endblock %}
{% block content %}
{% set capacity_mode = capacity_display|default('free_numbers') %}
{% set wahlMap = old.wahl|default({}) %}
{% set altMap = old.alt|default({}) %}
<section class="card app-card">
    <div class="card-body p-4">
        <h1 class="h2 mb-3">Sportkurse wählen</h1>
        <p class="text-muted mb-3">Bitte kreuzen Sie für jedes Halbjahr eine <strong>1.&nbsp;Wahl</strong> und eine <strong>Alternative</strong> an.</p>

        {% if admin_test_mode|default(false) %}
            <div class="alert alert-info">Testmodus: Die öffentliche Anmeldung ist geschlossen. Als Administrator können Sie den Ablauf trotzdem prüfen.</div>
        {% endif %}

        {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

        {% if not form_ready|default(false) %}
            <div class="alert alert-warning">
                Die Anmeldung ist noch nicht vollständig eingerichtet. Es müssen vier aktive Halbjahre mit jeweils mindestens zwei wählbaren Kursen vorhanden sein.
            </div>
            <p class="mb-0"><a class="btn btn-outline-primary" href="/">Zur Startseite</a></p>
        {% else %}
            <form method="post" action="/anmelden" id="register-form">
                {{ csrf.field()|raw }}

                {% for hj in halbjahre %}
                    {% set hjId = hj.id %}
                    {% set oldWahl = attribute(wahlMap, hjId)|default(attribute(wahlMap, hjId ~ '')|default('')) %}
                    {% set oldAlt = attribute(altMap, hjId)|default(attribute(altMap, hjId ~ '')|default('')) %}
                    <div class="mb-4">
                        <h2 class="h5 mb-2">{{ hj.name }}</h2>
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle choice-matrix mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Kurs</th>
                                        <th scope="col" class="text-center choice-col">1. Wahl</th>
                                        <th scope="col" class="text-center choice-col">Alternative</th>
                                        <th scope="col" class="text-nowrap">Plätze</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for k in hj.kurse %}
                                    {% set is_gray = not k.aktiv or k.frei <= 0 %}
                                    {% set is_full = k.frei <= 0 %}
                                    <tr class="{% if is_gray %}is-gray{% endif %}">
                                        <td>
                                            <span class="fw-medium">{{ k.name }}</span>
                                            {% if not k.aktiv %}
                                                <span class="badge text-bg-secondary ms-1">gesperrt</span>
                                            {% elseif is_full %}
                                                <span class="badge text-bg-warning ms-1">ausgebucht</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            {% if k.aktiv and not is_full %}
                                                <input class="form-check-input choice-radio"
                                                       type="radio"
                                                       name="wahl[{{ hjId }}]"
                                                       value="{{ k.id }}"
                                                       id="wahl-{{ hjId }}-{{ k.id }}"
                                                       data-hj="{{ hjId }}"
                                                       data-role="wahl"
                                                       {% if oldWahl != '' and oldWahl == k.id %}checked{% endif %}
                                                       required>
                                            {% else %}
                                                <span class="choice-blocked" aria-hidden="true">—</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            {% if k.aktiv %}
                                                <input class="form-check-input choice-radio"
                                                       type="radio"
                                                       name="alt[{{ hjId }}]"
                                                       value="{{ k.id }}"
                                                       id="alt-{{ hjId }}-{{ k.id }}"
                                                       data-hj="{{ hjId }}"
                                                       data-role="alt"
                                                       {% if oldAlt != '' and oldAlt == k.id %}checked{% endif %}
                                                       required>
                                            {% else %}
                                                <span class="choice-blocked" aria-hidden="true">—</span>
                                            {% endif %}
                                        </td>
                                        <td class="small text-muted">
                                            {% if capacity_mode == 'free_numbers' %}
                                                {{ k.frei }}/{{ k.kapazitaet }}
                                            {% elseif capacity_mode == 'off' %}
                                                —
                                            {% else %}
                                                {% if is_full %}voll{% else %}frei{% endif %}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4" class="text-muted">Keine Kurse in diesem Halbjahr.</td></tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endfor %}

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="name">Name</label>
                        <input class="form-control" type="text" name="name" id="name" required value="{{ old.name|default('') }}" autocomplete="name">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="tutorium">Tutorium</label>
                        <input class="form-control" type="text" name="tutorium" id="tutorium" required value="{{ old.tutorium|default('') }}" autocomplete="organization">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="email">E-Mail</label>
                        <input class="form-control" type="email" name="email" id="email" required value="{{ old.email|default('') }}" autocomplete="email">
                    </div>
                </div>

                {% include 'partials/bot_protection.twig' %}

                <button type="submit" class="btn btn-primary">Anmeldung absenden</button>
                <a class="btn btn-outline-primary ms-2" href="/">Abbrechen</a>
            </form>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block scripts %}
{% set bp = bot_protection|default({enabled: false, script_url: ''}) %}
{% if bp.enabled and bp.script_url %}
<script src="{{ bp.script_url }}" async defer></script>
{% endif %}
<script>
(function () {
    var form = document.getElementById('register-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
        var hjs = {};
        form.querySelectorAll('input[data-role="wahl"]:checked').forEach(function (el) {
            hjs[el.getAttribute('data-hj')] = hjs[el.getAttribute('data-hj')] || {};
            hjs[el.getAttribute('data-hj')].wahl = el.value;
        });
        form.querySelectorAll('input[data-role="alt"]:checked').forEach(function (el) {
            hjs[el.getAttribute('data-hj')] = hjs[el.getAttribute('data-hj')] || {};
            hjs[el.getAttribute('data-hj')].alt = el.value;
        });
        for (var id in hjs) {
            if (hjs[id].wahl && hjs[id].alt && hjs[id].wahl === hjs[id].alt) {
                e.preventDefault();
                alert('1. Wahl und Alternative müssen je Halbjahr unterschiedlich sein.');
                return;
            }
        }
    });
})();
</script>
{% endblock %}
